# Copy this file to .env and fill in your credentials
# Never commit .env to git

LIBRE_EMAIL=your_librelinkup_email@example.com
LIBRE_PASSWORD=your_librelinkup_password

# EU server (Germany uses eu2)
# Options: api-eu.libreview.io, api-eu2.libreview.io, api-us.libreview.io
LIBRE_URL=https://api-eu2.libreview.io

# How often to poll in minutes (min 5 to avoid rate limiting)
POLL_INTERVAL_MINUTES=5
